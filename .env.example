# App
APP_ENV=dev
DATABASE_URL=sqlite:///./techmatch.db

# Public job board APIs (all have free tiers)
ADZUNA_APP_ID=
ADZUNA_API_KEY=
USAJOBS_API_KEY=
REMOTIVE_API_BASE=https://remotive.com/api

# Scrapers (use responsibly; respect each site's ToS & robots.txt)
SCRAPE_ENABLED=false
USER_AGENT=TechMatchBot/0.1 (+contact@example.com)
PROXY_URL=

# Embeddings run locally (sentence-transformers). No key needed.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM re-ranking (optional). Leave blank to skip LLM step.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=            # openai | anthropic
LLM_MODEL=               # e.g. gpt-4o-mini or claude-3-5-haiku-latest
LLM_RERANK_TOP_N=20
