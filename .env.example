# App
APP_ENV=dev
DATABASE_URL=sqlite:///./techmatch.db

# Public job board APIs (all have free tiers)
ADZUNA_APP_ID=
ADZUNA_API_KEY=
USAJOBS_API_KEY=
REMOTIVE_API_BASE=https://remotive.com/api

# Scrapers (use responsibly; respect each site's ToS & robots.txt)
SCRAPE_ENABLED=false
USER_AGENT=TechMatchBot/0.1 (+contact@example.com)
PROXY_URL=

# Embeddings run locally (sentence-transformers). No key needed.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM re-ranking (optional). Leave LLM_PROVIDER blank to skip.
# Recommended: Z.AI (OpenAI-compatible). Free-tier model: glm-4.5-flash.
LLM_PROVIDER=zai                       # zai | openai | anthropic
LLM_MODEL=glm-4.5-flash                # zai: glm-4.5-flash (free) | glm-4.6 (paid)
LLM_BASE_URL=https://api.z.ai/api/paas/v4/
LLM_API_KEY=                           # your provider api key
LLM_RERANK_TOP_N=20
